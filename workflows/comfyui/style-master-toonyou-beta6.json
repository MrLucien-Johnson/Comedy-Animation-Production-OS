{
  "workflow_id": "style-master-toonyou-beta6-v1",
  "workflow_version": "1",
  "template_only": false,
  "requires_local_checkpoint": true,
  "operator_verified_topology": true,
  "operator_verification_note": "Topology matches operator-verified ComfyUI Desktop graph (CheckpointLoaderSimple → CLIP encodes → EmptyLatent → KSampler → VAEDecode → SaveImage). Prefer replacing this file with ComfyUI Save (API Format) export if node IDs differ.",
  "vram_class": "LOW_6GB",
  "intended_resolution": [512, 512],
  "default_checkpoint": "toonyou_beta6.safetensors",
  "default_settings": {
    "steps": 20,
    "cfg": 7.0,
    "sampler_name": "euler",
    "scheduler": "normal",
    "denoise": 1.0,
    "batch_size": 1
  },
  "description": "CAPOS API workflow for style-master on LOW_VRAM_6GB with ToonYou Beta 6. CAPOS always injects an explicit seed — do not rely on randomize-after-generate.",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "toonyou_beta6.safetensors"
      },
      "_meta": {
        "capos_role": "checkpoint",
        "title": "Load Checkpoint"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "POSITIVE",
        "clip": ["1", 1]
      },
      "_meta": {
        "capos_role": "positive",
        "title": "Positive"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "NEGATIVE",
        "clip": ["1", 1]
      },
      "_meta": {
        "capos_role": "negative",
        "title": "Negative"
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "_meta": {
        "capos_role": "size",
        "title": "Latent"
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "_meta": {
        "capos_role": "sampler",
        "title": "Sampler"
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      },
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "capos_style_master",
        "images": ["6", 0]
      },
      "_meta": {
        "capos_role": "output",
        "title": "Save"
      }
    }
  }
}
