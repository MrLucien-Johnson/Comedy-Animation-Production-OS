# Copy to .env and fill as needed. Never commit .env.
# CAPOS_PROJECT_ROOT=/absolute/path/to/repo
# CAPOS_MOCK_GENERATION=1   # CI/demo only — never production canon
#
# === Preferred local production (RTX 3050 / ComfyUI Desktop) ===
# CAPOS_COMFYUI_URL=http://127.0.0.1:8188
# CAPOS_COMFYUI_CHECKPOINT=toonyou_beta6.safetensors
# CAPOS_COMFYUI_WORKFLOW=style-master-toonyou-beta6.json
# CAPOS_COMFYUI_WORKFLOW_PATH=   # optional absolute path to ComfyUI Save (API Format) JSON
# CAPOS_COMFYUI_MODEL_ID=toonyou_beta6
# CAPOS_COMFYUI_MODEL_LICENCE="see config/model_provenance/toonyou_beta6.json — review source terms"
# CAPOS_COMFYUI_MODEL_LICENCE_STATUS=UNVERIFIED
#   # Set to VERIFIED only after human reviews licence at model source
#
# Optional / secondary:
# HF_TOKEN=
# CAPOS_LOCAL_MODEL_PATH=
